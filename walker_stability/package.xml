<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walker_stability</name>
  <version>0.0.1</version>
  <description>Stability of the user: the margin of their centre of mass inside the support polygon of their feet and the walker handles, from the leg and handle loads</description>
  <maintainer email="manolofc@gmail.com">Manuel Fernandez-Carmona</maintainer>
  <license>Creative Commons</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>walker_msgs</depend>
  <depend>walker_loads</depend>
  <depend>tf2_ros_py</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
