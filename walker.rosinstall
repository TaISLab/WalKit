# The workspace's public sources. `local-name` is the path inside the workspace's `src` folder; `version` is a branch (but for the one commit
# that a comment explains). This is the layout of ~/workspace/walker_ws/src as of 2026-10-28:
#   vcs import src < walker.rosinstall      (or: wstool init src walker.rosinstall)
#
# The mocap4w tools are not here: they are in private repositories, and are listed in mocap4w.rosinstall (in the mocap_analysis repository)
# with what only they need (the human model, the old mocap messages, Shimmer). Import this file first.

# --- The walker ---
- git:
    uri: https://github.com/TaISLab/WalKit.git
    local-name: WalKit
    version: jazzy

# --- Sensors ---
- git:
    uri: https://github.com/Slamtec/rplidar_ros.git
    local-name: lidar/rplidar_ros
    version: ros2

- git:
    uri: https://github.com/ElettraSciComp/witmotion_IMU_ros.git
    local-name: witmotion/witmotion_ros
    version: ros2

# witmotion_ros adds this one as a subdirectory (add_subdirectory(witmotion-uart-qt) in its CMakeLists.txt) and builds it inside itself, at
# the commit its own submodule pins (v0.9.17-alpha-33; main is 11 commits ahead). It is the only copy needed: do not clone it also at the
# top level, where colcon would build it as a package of its own that nothing uses.
- git:
    uri: https://github.com/ElettraSciComp/witmotion_IMU_QT.git
    local-name: witmotion/witmotion_ros/witmotion-uart-qt
    version: 5c2e86dd2ba7dba76d84e68fa7f65dc3527f5de0

# --- Laser odometry and scan segmentation ---
- git:
    uri: https://github.com/TaISLab/ros2_laser_scan_matcher.git
    local-name: lidar/ros2_laser_scan_matcher
    version: main

- git:
    uri: https://github.com/AlexKaravaev/csm.git
    local-name: csm
    version: ros2_csm_eigen

- git:
    uri: https://github.com/ajtudela/slg_msgs.git
    local-name: ajt_segment/slg_msgs
    version: jazzy

- git:
    uri: https://github.com/ajtudela/laser_segmentation.git
    local-name: ajt_segment/laser_segmentation
    version: jazzy

# --- Mocap (MOCAP4ROS2) ---
# mocap4r2 is the former `mocap` repository; the messages mocap_msgs and mocap_control_msgs are in its old_msgs folder
- git:
    uri: https://github.com/MOCAP4ROS2-Project/mocap4r2.git
    local-name: mocap4r2/mocap4r2
    version: rolling

- git:
    uri: https://github.com/MOCAP4ROS2-Project/mocap_interfaces.git
    local-name: mocap4r2/mocap_interfaces
    version: rolling

- git:
    uri: https://github.com/MOCAP4ROS2-Project/mocap4ros2_vicon.git
    local-name: mocap4r2/mocap4ros2_vicon
    version: rolling

# --- E4 messages (used by mocap_analysis) ---
- git:
    uri: https://github.com/TaISLab/e4_msgs.git
    local-name: e4_msgs
    version: main

# --- Shimmer (commented out) ---
#  The workspace uses ros_shimmer, which is private: it is in mocap4w.rosinstall.
